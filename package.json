    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "marked": "^16.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "jsdom": "^30.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.40.0"
  }
}
